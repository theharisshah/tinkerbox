{
  "name": "tinkerbox",
  "productName": "Tinkerbox",
  "version": "0.1.0",
  "description": "A desktop PHP & Laravel code runner built on Electron",
  "main": "./out/main/index.js",
  "author": "Haris Shah",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:php": "php -d xdebug.mode=off tests/php/run.php",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "postinstall": "electron-builder install-app-deps",
    "prepare:sandbox": "node scripts/prepare-sandbox.mjs",
    "icons": "sh scripts/build-icons.sh"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource/fira-code": "^5.3.0",
    "@prettier/plugin-php": "^0.25.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "dompurify": "^3.4.16",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-vue-next": "^1.0.0",
    "marked": "^18.1.0",
    "monaco-editor": "^0.57.0",
    "monaco-vim": "^0.4.4",
    "pinia": "^3.0.4",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9",
    "vite": "7.3",
    "vitest": "^5.0.3",
    "vue": "3.5",
    "vue-tsc": "^3.3.12"
  },
  "dependencies": {
    "electron-log": "^5.4.4"
  }
}
